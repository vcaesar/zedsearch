// Format: https://containers.dev/implementors/json_reference/
{
	"name": "ZedSearch",
	// Floating tag: latest Go 1.27 patch on Debian trixie.
	"image": "mcr.microsoft.com/devcontainers/go:1.27-trixie",
	"features": {
		// frontend/ and -tags web builds need Node.js 24 + npm.
		"ghcr.io/devcontainers/features/node:1": { "version": "24" }
	},
	// First-run admin; override from the host environment.
	"containerEnv": {
		"ZED_FIRST_ADMIN_USER": "${localEnv:ZED_FIRST_ADMIN_USER:admin}",
		"ZED_FIRST_ADMIN_PASSWORD": "${localEnv:ZED_FIRST_ADMIN_PASSWORD:Complexpass#123}"
	},
	"forwardPorts": [4080],
	"postCreateCommand": "go mod download",
	"customizations": {
		"vscode": {
			"extensions": ["golang.go", "dbaeumer.vscode-eslint"]
		}
	},
	"remoteUser": "vscode"
}
